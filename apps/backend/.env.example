DB_HOST="localhost"
DB_PORT="5689"
DB_USER="br_data_hub_br_data_hub"
DB_PASSWORD="docker"
DB_NAME="br_data_hub_br_data_hub_db"
DATABASE_URL="postgresql://br_data_hub_br_data_hub:docker@localhost:5689/br_data_hub_br_data_hub_db?schema=public"
PORT="4000"
# Segredo de assinatura do JWT. Valor apenas de exemplo: gere um proprio por
# ambiente (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# e NUNCA reaproveite este valor em producao.
JWT_SECRET="e4drU8auaTIrYg7VQkR9fIwMdOR3OO_CsZ5a_cgGigk1bj10R3_yeHrRk50XF5fl"
JWT_EXPIRES_IN="1d"

# URL base da API ViaCEP (publica, sem ApiKey; formato json). Opcional: padrao https://viacep.com.br/ws
VIACEP_BASE_URL="https://viacep.com.br/ws"

# URL base da BrasilAPI (publica, sem ApiKey). Opcional: padrao https://brasilapi.com.br/api
BRASILAPI_BASE_URL="https://brasilapi.com.br/api"

# Redis das filas BullMQ (servico `redis` do docker-compose, porta 6389 no host)
REDIS_HOST="localhost"
REDIS_PORT="6389"
# Prefixo das chaves das filas no Redis. Opcional: padrao bull
BR_DATA_QUEUE_PREFIX="bull"

# Rate-limit das filas de enriquecimento: no maximo MAX jobs a cada DURATION_MS.
# Nem a ViaCEP nem a BrasilAPI publicam limite numerico (ambas bloqueiam uso
# massivo), entao os padroes sao conservadores. Opcionais: padroes 30/min e 10/min.
VIACEP_RATE_LIMIT_MAX="30"
VIACEP_RATE_LIMIT_DURATION_MS="60000"
BRASILAPI_RATE_LIMIT_MAX="10"
BRASILAPI_RATE_LIMIT_DURATION_MS="60000"
# Pausa da fila quando a API externa responde 429. Opcional: padrao 60000
BR_DATA_RATE_LIMIT_BACKOFF_MS="60000"
# Quanto o POST /br-data espera os jobs antes de devolver os jobIds (202). Opcional: padrao 15000
BR_DATA_SYNC_WAIT_MS="15000"
