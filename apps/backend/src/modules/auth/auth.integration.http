###############################################################################
# auth — testes de integração HTTP (plugin REST Client do VS Code)
#
# Como usar:
# - Cada bloco separado por `###` vira um botão "Send Request" no VS Code.
# - Variáveis de arquivo (`@nome = valor`) centralizam base URL e massa de teste.
# - Referencie uma variável com `{{nome}}` na URL, no header ou no body.
# - Um request nomeado (`# @name registrar`) guarda a última resposta; use-a
#   depois com `{{registrar.response.body.$.<campo>}}`.
# - Incremente `@entityVersion` para uma rodada limpa (gera um e-mail novo e
#   evita colidir com o usuário já cadastrado na rodada anterior).
#
# Suba o backend antes: `npm --workspace apps/backend run start:dev`
###############################################################################

@baseUrl = http://localhost:4000
@contentType = application/json

# Troque a versão a cada rodada limpa para gerar um usuário inédito.
@entityVersion = 1
@userName = Joao Silva
@userEmail = joao.silva+{{entityVersion}}@example.com
@userPassword = Strong@123

### 1) Registrar usuário com payload válido -> 201
# @name registrar
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "{{userName}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2) Repetir o mesmo e-mail -> 422 user.email.already.registered
# Rode o request 1 antes deste. A senha é gravada como hash bcrypt, nunca em texto.
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "{{userName}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 3) Senha fraca -> 422 user.password.strong.password
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Maria Souza",
  "email": "maria.souza+{{entityVersion}}@example.com",
  "password": "123456"
}

### 4) E-mail em formato inválido -> 422 user.email.invalid.email
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Maria Souza",
  "email": "maria.souza",
  "password": "{{userPassword}}"
}

### 5) Nome sem sobrenome -> 422 user.name.person.name
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Maria",
  "email": "maria.sem.sobrenome+{{entityVersion}}@example.com",
  "password": "{{userPassword}}"
}

### 6) Nome curto demais -> 422 user.name.min.length + user.name.person.name
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "ab",
  "email": "nome.curto+{{entityVersion}}@example.com",
  "password": "{{userPassword}}"
}

### 7) Body vazio -> 422 com todos os `required`
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{}

###############################################################################
# Login — POST /auth/login
# Rode o request 1 antes destes: o login depende do usuário já cadastrado.
# O request nomeado `login` guarda o token para as rotas protegidas.
###############################################################################

### 8) Login com credenciais válidas -> 200 { token, user }
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Token emitido no request 8, pronto para as rotas protegidas.
@token = {{login.response.body.$.token}}

### 9) E-mail inexistente -> 401 user.credentials.invalid
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "nao.cadastrado+{{entityVersion}}@example.com",
  "password": "{{userPassword}}"
}

### 10) Senha incorreta -> 401 user.credentials.invalid
# Mesma mensagem do request 9: a resposta não revela quais e-mails existem.
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "Outra@Senha123"
}

### 11) E-mail em formato inválido -> 422 user.email.invalid.email
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "sem-arroba",
  "password": "{{userPassword}}"
}

### 12) Corpo incompleto -> 422 user.email.required + user.password.required
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{}
