# URL base da API do backend (inclui o prefixo /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Proteção das rotas privadas. Com "false", todas as páginas ficam abertas para
# navegação (útil só em desenvolvimento, sem backend).
AUTH_ENABLED=true

# Cookie que identifica a sessão do usuário autenticado (gravado pelo frontend
# após o login, com o token JWT retornado pelo backend).
NEXT_PUBLIC_AUTH_SESSION_COOKIE=access_token
