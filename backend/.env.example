# Porta HTTP do servidor
PORT=3000
ENVIRONMENT=development

# ---- Banco de dados (PostgreSQL) - preencha os valores abaixo ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Montada a partir das variáveis acima (Prisma CLI e src/config/env.js expandem ${VAR})
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

DATE_FORMAT="DD/MM/YYYY HH:mm:ss"
LOGS_PATH=logs/app.log

CORS_ORIGIN_ALLOWED=http://localhost:4000

# ---- Autenticação (JWT) ----
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ---- Redefinição de senha ----
# URL do frontend usada para montar o link enviado por email
FRONTEND_URL=http://localhost:4000
RESET_PASSWORD_TOKEN_EXPIRES_IN_MINUTES=30

# ---- Envio de email (SMTP; opcional) ----
# Sem SMTP_HOST/SMTP_USER/SMTP_PASSWORD preenchidos, nenhum email é enviado
# (o envio ignorado é apenas registrado no log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@brdatahub.com

# ---- ViaCEP (opcional; estes são os valores padrão) ----
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT_MS=5000

# ---- BrasilAPI (opcional; estes são os valores padrão) ----
BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cnpj/v1
BRASILAPI_TIMEOUT_MS=10000

# ---- Redis (filas do BullMQ e rate limit; suba com: docker compose up -d redis) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Rate limit das APIs externas (opcional; estes são os valores padrão) ----
# Máximo de chamadas por janela (ms) e jobs processados em paralelo pela fila
VIACEP_RATE_LIMIT_MAX=3
VIACEP_RATE_LIMIT_DURATION_MS=1000
VIACEP_QUEUE_CONCURRENCY=3
BRASILAPI_RATE_LIMIT_MAX=3
BRASILAPI_RATE_LIMIT_DURATION_MS=1000
BRASILAPI_QUEUE_CONCURRENCY=3
